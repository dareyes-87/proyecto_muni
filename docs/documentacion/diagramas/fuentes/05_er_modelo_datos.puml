@startuml 05_er_modelo_datos
' Fuente: analisis/02_modelo_datos.md (actualizado a bdf1187), backend/prisma/schema.prisma y
' backend/prisma/migrations/0_init/migration.sql. Nombres físicos de tablas y columnas.
' Notación pata de gallo; cardinalidades según las claves foráneas de la base de datos.
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 11
skinparam dpi 150
skinparam linetype ortho
hide circle
hide empty members

title Modelo entidad-relación — FarmaG (14 tablas)

entity "usuarios" as usuarios {
  * id : text <<PK>>
  --
  * username : text <<UK>>
  email : text <<UK>>
  * password_hash : text
  * nombre_completo : text
  * rol : "Rol"
  * activo : boolean
  ultimo_acceso : timestamp(3)
  * created_at : timestamp(3)
  * updated_at : timestamp(3)
}

entity "categorias" as categorias {
  * id : text <<PK>>
  --
  * nombre : text <<UK>>
  descripcion : text
  * activo : boolean
}

entity "medicamentos" as medicamentos {
  * id : text <<PK>>
  --
  * nombre_generico : text
  nombre_comercial : text
  * presentacion : text
  concentracion : text
  * unidad_medida : text
  * categoria_id : text <<FK>>
  * stock_minimo : integer
  imagen_url : text
  * activo : boolean
  * created_at : timestamp(3)
  * updated_at : timestamp(3)
}

entity "codigos_barras" as codigos_barras {
  * id : text <<PK>>
  --
  * medicamento_id : text <<FK>>
  * codigo : text <<UK>>
  descripcion : text
}

entity "ubicaciones" as ubicaciones {
  * id : text <<PK>>
  --
  * codigo : text <<UK>>
  descripcion : text
}

entity "entradas" as entradas {
  * id : text <<PK>>
  --
  * usuario_id : text <<FK>>
  observaciones : text
  * created_at : timestamp(3)
}

entity "lotes" as lotes {
  * id : text <<PK>>
  --
  * entrada_id : text <<FK>>
  * medicamento_id : text <<FK>>
  * cantidad : integer
  * cantidad_actual : integer
  * numero_lote : text
  * fecha_vencimiento : date
  costo_unitario : numeric(10,2)
  ubicacion_id : text <<FK>>
  * estado : "EstadoLote"
  * created_at : timestamp(3)
}

entity "beneficiarios" as beneficiarios {
  * id : text <<PK>>
  --
  * nombre_completo : text
  dpi : text <<UK>>
  telefono : text
  direccion : text
  observaciones : text
  * activo : boolean
  * created_at : timestamp(3)
  * updated_at : timestamp(3)
}

entity "dispensaciones" as dispensaciones {
  * id : text <<PK>>
  --
  * beneficiario_id : text <<FK>>
  * usuario_id : text <<FK>>
  observaciones : text
  * created_at : timestamp(3)
}

entity "detalle_dispensaciones" as detalle {
  * id : text <<PK>>
  --
  * dispensacion_id : text <<FK>>
  * lote_id : text <<FK>>
  * medicamento_id : text <<FK>>
  * cantidad : integer
  * nombre_medicamento_snapshot : text
  * presentacion_snapshot : text
  concentracion_snapshot : text
}

entity "fotos_dispensacion" as fotos {
  * id : text <<PK>>
  --
  * dispensacion_id : text <<FK>> <<UK1>>
  * tipo : "TipoFoto" <<UK1>>
  * imagen_url : text
  * created_at : timestamp(3)
}

entity "tokens_captura" as tokens {
  * id : text <<PK>>
  --
  * dispensacion_id : text <<FK>> <<UK>>
  * token : text <<UK>>
  * usado : boolean
  * expira_en : timestamp(3)
  * created_at : timestamp(3)
}

entity "log_auditoria" as log {
  * id : text <<PK>>
  --
  * usuario_id : text <<FK>>
  * accion : "AccionAuditoria"
  * entidad : text
  entidad_id : text
  datos_anteriores : jsonb
  datos_nuevos : jsonb
  ip_address : text
  * created_at : timestamp(3)
}

entity "configuracion_sistema" as config {
  * id : text <<PK>>
  --
  * clave : text <<UK>>
  * valor : text
  descripcion : text
}

categorias ||--o{ medicamentos
medicamentos ||--o{ codigos_barras
medicamentos ||--o{ lotes
ubicaciones |o--o{ lotes
usuarios ||--o{ entradas
entradas ||--o{ lotes
lotes ||--o{ detalle
medicamentos ||--o{ detalle
beneficiarios ||--o{ dispensaciones
usuarios ||--o{ dispensaciones
dispensaciones ||--o{ detalle
dispensaciones ||--o{ fotos
dispensaciones ||--o| tokens
usuarios ||--o{ log

legend bottom left
  * = NOT NULL · PK = clave primaria (UUID generado por Prisma) · FK = clave foránea
  UK = único · UK1 = único compuesto (dispensacion_id, tipo)
  FK obligatorias: ON UPDATE CASCADE ON DELETE RESTRICT; lotes.ubicacion_id: ON DELETE SET NULL.
  configuracion_sistema no tiene relaciones.
endlegend
@enduml
