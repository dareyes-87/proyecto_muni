# Copie este archivo a .env y reemplace los valores. NO escriba secretos reales
# en este archivo de ejemplo (está versionado en el repositorio).

# === Base de Datos ===
DB_USER=farmag
# Defina una contraseña propia. En producción NO use valores de ejemplo.
DB_PASSWORD=CAMBIE_ESTA_CONTRASENA
DB_NAME=farmag_db

# === Administrador inicial (bootstrap seguro, H-002) ===
# Ya NO hay contraseña por defecto. El primer admin se crea con estos valores.
# Si deja ADMIN_INITIAL_PASSWORD vacía, el seed genera una aleatoria y la imprime
# UNA vez en los logs del contenedor api. Mínimo 8 caracteres, no valores comunes.
ADMIN_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=
# ADMIN_EMAIL=admin@farmag.local

# === API ===
# development | production
NODE_ENV=development
# Secreto para firmar los JWT. Genere uno largo y aleatorio, por ejemplo:
#   openssl rand -hex 32
# En producción el backend NO arranca si este valor es de ejemplo o corto (<16).
JWT_SECRET=CAMBIE_ESTE_SECRETO_POR_UNO_ALEATORIO
JWT_EXPIRES_IN=8h
# Orígenes permitidos para CORS, separados por comas (p. ej. http://192.168.1.7).
# En la operación normal el frontend llega a la API por el mismo origen (proxy),
# así que puede dejarse vacío. En producción, si se define, solo esos orígenes
# podrán hacer peticiones cross-origin.
# CORS_ORIGIN=

# === Frontend ===
# En desarrollo usa "development", en producción usa "production"
FRONTEND_TARGET=development

# === Red local (QR de captura de evidencia) ===
# Se detecta automáticamente al usar start.cmd (Windows) o start.sh (Linux/Mac).
# Solo necesita valor aquí si quieres forzar una IP específica:
# LAN_IP=192.168.1.7
